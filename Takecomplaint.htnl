<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CartPrime - Complaint Management Dashboard</title>
  <style>
    :root {
      --bg-dark: #121212;
      --card-bg: #1e1e1e;
      --primary-yellow: #f5a623;
      --primary-hover: #d48b16;
      --text-white: #ffffff;
      --text-muted: #aaaaaa;
      --border-color: #333333;
      --status-pending: #e74c3c;
      --status-resolved: #2ecc71;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-white);
      padding: 20px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid var(--border-color);
      padding-bottom: 15px;
      margin-bottom: 25px;
    }

    .logo-container {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-text {
      font-size: 26px;
      font-weight: bold;
    }

    .logo-text span {
      color: var(--primary-yellow);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .dashboard-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: var(--card-bg);
      border-left: 4px solid var(--primary-yellow);
      padding: 15px 20px;
      border-radius: 6px;
    }

    .stat-card h3 {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .stat-card p {
      font-size: 24px;
      font-weight: bold;
    }

    .filters {
      margin-bottom: 20px;
      display: flex;
      gap: 10px;
    }

    .filter-btn {
      background: var(--card-bg);
      color: var(--text-white);
      border: 1px solid var(--border-color);
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      transition: 0.3s;
    }

    .filter-btn.active, .filter-btn:hover {
      background: var(--primary-yellow);
      color: var(--bg-dark);
      font-weight: bold;
    }

    .table-container {
      background: var(--card-bg);
      border-radius: 8px;
      overflow-x: auto;
      border: 1px solid var(--border-color);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th, td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-color);
    }

    th {
      background-color: #262626;
      color: var(--primary-yellow);
      font-weight: 600;
    }

    tr:hover {
      background-color: #2a2a2a;
    }

    .badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
      display: inline-block;
    }

    .badge-pending {
      background-color: rgba(231, 76, 60, 0.2);
      color: var(--status-pending);
      border: 1px solid var(--status-pending);
    }

    .badge-resolved {
      background-color: rgba(46, 204, 113, 0.2);
      color: var(--status-resolved);
      border: 1px solid var(--status-resolved);
    }

    .action-btn {
      background-color: var(--primary-yellow);
      color: var(--bg-dark);
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    .action-btn:hover {
      background-color: var(--primary-hover);
    }

    .action-btn:disabled {
      background-color: #444;
      color: #888;
      cursor: not-allowed;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <div class="logo-container">
        <div class="logo-text">Cart<span>Prime</span> Admin</div>
      </div>
      <div>Complaint Resolution Portal</div>
    </header>

    <div class="dashboard-summary">
      <div class="stat-card">
        <h3>Total Complaints</h3>
        <p id="total-count">0</p>
      </div>
      <div class="stat-card">
        <h3>Pending</h3>
        <p id="pending-count">0</p>
      </div>
      <div class="stat-card">
        <h3>Resolved</h3>
        <p id="resolved-count">0</p>
      </div>
    </div>

    <div class="filters">
      <button class="filter-btn active" onclick="filterComplaints('all', this)">All</button>
      <button class="filter-btn" onclick="filterComplaints('Pending', this)">Pending</button>
      <button class="filter-btn" onclick="filterComplaints('Resolved', this)">Resolved</button>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Ticket ID</th>
            <th>Customer</th>
            <th>Issue Title</th>
            <th>Date</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="complaint-table-body">
          <!-- Rows will be dynamically loaded via JavaScript -->
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const complaints = [
      { id: "CP-1001", customer: "Rahul Kumar", issue: "Item received damaged", date: "2026-08-30", status: "Pending" },
      { id: "CP-1002", customer: "Anjali Nair", issue: "Payment deducted, order not placed", date: "2026-08-31", status: "Pending" },
      { id: "CP-1003", customer: "Vijay Joseph", issue: "Wrong item delivered", date: "2026-08-29", status: "Resolved" },
      { id: "CP-1004", customer: "Sreya P", issue: "Delay in refund process", date: "2026-09-01", status: "Pending" }
    ];

    function renderTable(data) {
      const tbody = document.getElementById("complaint-table-body");
      tbody.innerHTML = "";

      data.forEach((item, index) => {
        const row = document.createElement("tr");

        const statusClass = item.status === "Pending" ? "badge-pending" : "badge-resolved";
        const isResolved = item.status === "Resolved";

        row.innerHTML = `
          <td><strong>${item.id}</strong></td>
          <td>${item.customer}</td>
          <td>${item.issue}</td>
          <td>${item.date}</td>
          <td><span class="badge ${statusClass}">${item.status}</span></td>
          <td>
            <button class="action-btn" ${isResolved ? "disabled" : ""} onclick="resolveComplaint('${item.id}')">
              ${isResolved ? "Solved" : "Mark Solved"}
            </button>
          </td>
        `;
        tbody.appendChild(row);
      });

      updateStats();
    }

    function resolveComplaint(id) {
      const target = complaints.find(item => item.id === id);
      if (target) {
        target.status = "Resolved";
        const activeFilter = document.querySelector(".filter-btn.active").innerText;
        
        if (activeFilter === "All") {
          renderTable(complaints);
        } else {
          filterComplaints(activeFilter, document.querySelector(".filter-btn.active"));
        }
      }
    }

    function filterComplaints(status, btnElement) {
      document.querySelectorAll(".filter-btn").forEach(btn => btn.classList.remove("active"));
      if(btnElement) btnElement.classList.add("active");

      if (status === 'all' || status === 'All') {
        renderTable(complaints);
      } else {
        const filtered = complaints.filter(c => c.status === status);
        renderTable(filtered);
      }
    }

    function updateStats() {
      document.getElementById("total-count").innerText = complaints.length;
      document.getElementById("pending-count").innerText = complaints.filter(c => c.status === "Pending").length;
      document.getElementById("resolved-count").innerText = complaints.filter(c => c.status === "Resolved").length;
    }

    // Initial render
    renderTable(complaints);
  </script>
</body>
</html>
